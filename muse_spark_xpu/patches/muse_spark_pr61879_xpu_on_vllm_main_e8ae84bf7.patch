+
+    def materialize(self) -> MuseSpark1xResidualStream:
+        return MuseSpark1xResidualStream(
+            stream=self.stream,
+            branch=gather_columns(self.branch),
+            post_norm=self.post_norm,
+            connection=self.connection,
+        )
