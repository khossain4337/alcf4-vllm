+            );
+        }
+
+        let video_cases: &[Case] = &[
+            ((448, 448), (336, 336), (12, 12)),
+            // Tie between (3,3) and (4,4), see above.
+            ((100, 100), (84, 84), (3, 3)),
+            ((1000, 337), (560, 196), (20, 7)),
+            ((3333, 1111), (560, 196), (20, 7)),
+            ((4096, 8192), (224, 448), (8, 16)),
+            ((55, 3000), (28, 2464), (1, 88)),
+            ((719, 1280), (252, 448), (9, 16)),
